{
  "name": "codyssey-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.4",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0"
}
